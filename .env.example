# ═══════════════════════════════════════════════════════════════════════════════
# Example Environment Variables — copy to .env and fill in real values
# This file IS committed to git. Never put real secrets here.
# ═══════════════════════════════════════════════════════════════════════════════

# Cloud (web) database — PostgreSQL
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Desktop (Electron) offline database — local SQLite file
LOCAL_DATABASE_URL="file:./dev.db"
# Cloud API base URL the desktop app syncs against (leave blank for web/cloud deploys)
CLOUD_URL=""

JWT_SECRET="change-me-min-64-chars"
REFRESH_TOKEN_SECRET="change-me-min-64-chars"
# REQUIRED for desktop sync. Must be a strong unique value (>= 32 chars), NOT a
# placeholder, or branch tokens would be forgeable. Generate: openssl rand -base64 48
BRANCH_TOKEN_SECRET="change-me-min-64-chars"

SUPER_ADMIN_BOOTSTRAP_SECRET="change-me"

# Offline (desktop) license signing — Ed25519 (EdDSA), asymmetric.
# PRIVATE key lives ONLY here on the server; the matching PUBLIC key is
# embedded in the desktop app to verify tokens. Never reuse LICENSE_SECRET_KEY
# for this — that one is symmetric and ships inside the desktop installer,
# so anyone with it could forge lifetime licenses.
# Format: Ed25519 PKCS8 PEM, with real newlines written as the two characters \n
# (since env files are single-line). Generate with:
#   openssl genpkey -algorithm ed25519 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
# Never commit the real key or ship it to clients.
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nchange-me\n-----END PRIVATE KEY-----"

# Secures /api/cron/* endpoints (Vercel Cron sends it as a Bearer token automatically)
CRON_SECRET="change-me-random-value"

RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@your-domain.com"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="your-domain.com"

# ─── Rate limiting (optional, recommended for Vercel/serverless) ─────────────
# When set, rate limits are shared across all server instances via Upstash Redis.
# Leave blank to use the in-memory limiter (fine for a single instance).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── AI Assistant ─────────────────────────────────────────────────────────────
# Choose provider: 'gemini' (default, free tier) or 'openai'
AI_PROVIDER=gemini
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GEMINI_API_KEY="AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"