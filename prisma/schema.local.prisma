// Local SQLite schema for Electron desktop app (offline-first).
// This is a FULL mirror of schema.prisma with:
//   - provider = "sqlite"
//   - SyncMeta + SyncQueue models added
//   - No @db.* annotations (not supported in SQLite)
//   - Enums kept — Prisma stores them as TEXT in SQLite

generator client {
  provider   = "prisma-client-js"
  output     = "../node_modules/@prisma/client-local"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("LOCAL_DATABASE_URL")
}

// ─── Sync tracking (local-only tables) ───────────────────────────────────────

model SyncMeta {
  id          Int       @id @default(autoincrement())
  branchToken String
  tenantId    String
  branchId    String
  lastPullAt  DateTime?
  lastPushAt  DateTime?
  updatedAt   DateTime  @updatedAt
}

model SyncQueue {
  id        Int       @id @default(autoincrement())
  tableName String
  operation String    // INSERT | UPDATE | DELETE
  recordId  String
  payload   String    // JSON
  createdAt DateTime  @default(now())
  syncedAt  DateTime?
  attempts  Int       @default(0)
  lastError String?
}

// ─── Platform Level ───────────────────────────────────────────────────────────

model SubscriptionPlan {
  id           String   @id @default(cuid())
  name         String   @unique
  maxBranches  Int      @default(1)
  maxUsers     Int      @default(5)
  monthlyPrice Decimal  @default(0)
  yearlyPrice  Decimal  @default(0)
  features     String   @default("[]")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions TenantSubscription[]
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  status       String   @default("TRIAL")
  aiDailyLimit Int      @default(50)
  // Electron-only cache of the cloud subscription, populated at every online
  // login. Read on offline logins to block expired/suspended tenants locally.
  cachedSubscriptionStatus    String?
  cachedSubscriptionEndDate   DateTime?
  cachedSubscriptionPlanName  String?
  cachedAt                    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscription   TenantSubscription?
  branches       Branch[]
  users          User[]
  products       Product[]
  categories     Category[]
  customers      Customer[]
  suppliers      Supplier[]
  transactions   Transaction[]
  expenses       Expense[]
  offers         Offer[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  announcements  AnnouncementRecipient[]
  stockTransfers StockTransfer[]
  storeSettings  StoreSettings[]
  productBatches ProductBatch[]
  cashierShifts  CashierShift[]
  syncLogs       SyncLog[]
  paymentRecords PaymentRecord[]
  aiUsageLogs      AiUsageLog[]
  productUnits     ProductUnit[]
  cloudDeleteLogs  CloudDeleteLog[]
}

model TenantSubscription {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  planId            String
  status            String    @default("TRIAL")
  startDate         DateTime  @default(now())
  endDate           DateTime?
  trialEndDate      DateTime?
  gracePeriodEndsAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])
}

model PaymentRecord {
  id         String   @id @default(cuid())
  tenantId   String
  amount     Decimal
  months     Int
  planName   String?
  notes      String?
  paidAt     DateTime @default(now())
  recordedBy String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model AiUsageLog {
  id       String @id @default(cuid())
  tenantId String
  date     String
  count    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date])
}

// ─── Sync Delete Log ──────────────────────────────────────────────────────────
// Mirror of the cloud CloudDeleteLog — pulled from cloud and stored locally
// so that applyPull can detect what was deleted and remove it from SQLite.

model CloudDeleteLog {
  id        String   @id @default(cuid())
  tenantId  String
  table     String
  recordId  String
  deletedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, deletedAt])
}

model PlatformPaymentMethod {
  id            String   @id @default(cuid())
  type          String
  name          String
  accountNumber String?
  accountName   String?
  instructions  String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Branch {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  address        String?
  phone          String?
  activationCode String   @unique @default(cuid())
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  users              User[]
  transactions       Transaction[]
  expenses           Expense[]
  cashierShifts      CashierShift[]
  stockBatches       ProductBatch[]
  syncLogs           SyncLog[]
  customers          Customer[]
  stockTransfersFrom StockTransfer[] @relation("TransferFrom")
  stockTransfersTo   StockTransfer[] @relation("TransferTo")
  storeSettings      StoreSettings[]
  auditLogs          AuditLog[]
  supplierLedgers    SupplierLedger[]
  offers             Offer[]

  @@unique([tenantId, name])
}

// ─── User & Auth ──────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  tenantId       String
  branchId       String?
  username       String
  password       String
  role           String    @default("CASHIER")
  email          String?   @unique
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  // Electron-only: timestamp of the last successful cloud credential verification.
  // Used to enforce an offline grace period — see lib/sync-engine for the rule.
  lastCloudVerifyAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  transactions  Transaction[]
  shifts        CashierShift[]
  auditLogs     AuditLog[]
  notifications Notification[]
  refreshTokens RefreshToken[]

  @@unique([tenantId, username])
}

model SuperAdmin {
  id             String    @id @default(cuid())
  username       String    @unique
  password       String
  email          String?   @unique
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id           String    @id @default(cuid())
  token        String    @unique
  userId       String?
  superAdminId String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  user       User?       @relation(fields: [userId], references: [id])
  superAdmin SuperAdmin? @relation(fields: [superAdminId], references: [id])
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  offers   Offer[]

  @@unique([tenantId, name])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  categoryId  String?
  supplierId  String?
  costPrice    Decimal  @default(0)
  baseStock    Int      @default(0)
  minimumStock Int      @default(0)
  isQuickSale  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  units            ProductUnit[]
  batches          ProductBatch[]
  transactionItems TransactionItem[]
  offers           Offer[]
}

model ProductUnit {
  id               String  @id @default(cuid())
  productId        String
  tenantId         String
  name             String
  conversionFactor Int     @default(1)
  barcode          String?
  price            Decimal @default(0)

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  transactionItems TransactionItem[]

  @@index([barcode, tenantId])
}

model ProductBatch {
  id          String    @id @default(cuid())
  tenantId    String
  productId   String
  branchId    String
  batchNumber String?
  expiryDate  DateTime?
  quantity    Int
  costPrice   Decimal
  createdAt   DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id])
}

// ─── Suppliers ────────────────────────────────────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  phone       String?
  email       String?
  address     String?
  balance     Decimal  @default(0)
  creditLimit Decimal?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  products Product[]
  ledger   SupplierLedger[]
}

model SupplierLedger {
  id          String   @id @default(cuid())
  supplierId  String
  branchId    String?
  type        String
  amount      Decimal
  description String?
  date        DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])
}

// ─── Sales & Customers ────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String?
  name      String
  phone     String?
  email     String?
  address   String?
  balance   Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String
  type          String
  totalAmount   Decimal
  date          DateTime @default(now())
  userId        String?
  customerId    String?
  notes         String?
  discount      Decimal  @default(0)
  priceEdited   Boolean  @default(false)
  taxAmount     Decimal  @default(0)
  paymentMethod String   @default("CASH")
  paidAmount    Decimal?
  originalTxId  String?
  offerId       String?
  receiptNumber String?

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  branch   Branch            @relation(fields: [branchId], references: [id])
  user     User?             @relation(fields: [userId], references: [id])
  customer Customer?         @relation(fields: [customerId], references: [id])
  offer    Offer?            @relation(fields: [offerId], references: [id])
  items    TransactionItem[]
}

model TransactionItem {
  id            String  @id @default(cuid())
  transactionId String
  productId     String
  unitId        String
  quantity      Decimal @default(1)
  price         Decimal
  cost          Decimal @default(0)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  unit        ProductUnit @relation(fields: [unitId], references: [id])
}

// ─── Financial ────────────────────────────────────────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String
  title       String
  amount      Decimal
  category    String?
  description String?
  date        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
}

model CashierShift {
  id             String    @id @default(cuid())
  tenantId       String
  branchId       String
  userId         String
  openingAmount  Decimal   @default(0)
  closingAmount  Decimal?
  expectedAmount Decimal?
  difference     Decimal?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  notes          String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

// ─── Promotions ───────────────────────────────────────────────────────────────

model Offer {
  id          String    @id @default(cuid())
  tenantId    String
  branchId    String?
  name        String
  type        String
  value       Decimal
  buyQuantity Int?
  getQuantity Int?
  productId   String?
  categoryId  String?
  startDate   DateTime  @default(now())
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
  product  Product?  @relation(fields: [productId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  transactions Transaction[]
}

// ─── Settings ─────────────────────────────────────────────────────────────────

model StoreSettings {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String   @unique
  storeName     String   @default("سوبر ماركت")
  storeAddress  String?
  storePhone    String?
  taxNumber     String?
  taxRate       Decimal  @default(0)
  currency      String   @default("ريال")
  footerMessage String?
  autoPrint     Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
}

// ─── Stock Transfers ──────────────────────────────────────────────────────────

model StockTransfer {
  id           String   @id @default(cuid())
  tenantId     String
  fromBranchId String
  toBranchId   String
  items        String
  status       String   @default("PENDING")
  notes        String?
  requestedBy  String
  approvedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  fromBranch Branch @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch @relation("TransferTo", fields: [toBranchId], references: [id])
}

// ─── Sync Logs ────────────────────────────────────────────────────────────────

model SyncLog {
  id            String    @id @default(cuid())
  tenantId      String
  branchId      String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  status        String    @default("IN_PROGRESS")
  recordsPushed Int       @default(0)
  recordsPulled Int       @default(0)
  conflicts     String?
  error         String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
}

// ─── Audit & Notifications ───────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  branchId  String?
  userId    String?
  username  String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  type      String    @default("INFO")
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  recipients AnnouncementRecipient[]
}

model AnnouncementRecipient {
  id             String  @id @default(cuid())
  announcementId String
  tenantId       String
  isRead         Boolean @default(false)

  announcement Announcement @relation(fields: [announcementId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([announcementId, tenantId])
}

model LicenseLog {
  id            String    @id @default(cuid())
  clientName    String
  clientPhone   String?
  clientAddress String?
  duration      String
  expiresAt     DateTime?
  generatedAt   DateTime  @default(now())
  licenseKey    String
  machineId     String?
  generatedBy   String?
}
