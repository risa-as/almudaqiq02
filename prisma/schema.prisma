// Cloud schema — PostgreSQL (multi-tenant, multi-branch)
// Tenant-scoped models: tenantId on every row.
// Branch-scoped models: tenantId + branchId.
// Child models (TransactionItem, ProductUnit, SupplierLedger): scoped via parent relation.

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Platform Level (Super Admin) ────────────────────────────────────────────

model SubscriptionPlan {
  id           String   @id @default(cuid())
  name         String   @unique // "Basic", "Pro", "Enterprise"
  maxBranches  Int      @default(1) // 0 = unlimited
  maxUsers     Int      @default(5) // 0 = unlimited
  monthlyPrice Decimal  @default(0)
  yearlyPrice  Decimal  @default(0)
  features     String   @default("[]") // JSON array of feature names
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions TenantSubscription[]
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique // internal identifier
  status       String   @default("TRIAL") // TRIAL | ACTIVE | GRACE | SUSPENDED | CANCELLED
  aiDailyLimit Int      @default(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscription   TenantSubscription?
  branches       Branch[]
  users          User[]
  products       Product[]
  categories     Category[]
  customers      Customer[]
  suppliers      Supplier[]
  transactions   Transaction[]
  expenses       Expense[]
  offers         Offer[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  announcements  AnnouncementRecipient[]
  stockTransfers StockTransfer[]
  storeSettings  StoreSettings[]
  productBatches ProductBatch[]
  cashierShifts  CashierShift[]
  syncLogs       SyncLog[]
  paymentRecords PaymentRecord[]
  aiUsageLogs      AiUsageLog[]
  productUnits     ProductUnit[]
  cloudDeleteLogs  CloudDeleteLog[]
}

model TenantSubscription {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  planId            String
  status            String    @default("TRIAL") // TRIAL | ACTIVE | GRACE | EXPIRED | SUSPENDED | CANCELLED
  startDate         DateTime  @default(now())
  endDate           DateTime?
  trialEndDate      DateTime?
  gracePeriodEndsAt DateTime? // set when status transitions ACTIVE→GRACE (endDate + 5 days)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])
}

model PaymentRecord {
  id         String   @id @default(cuid())
  tenantId   String
  amount     Decimal
  months     Int
  planName   String?
  notes      String?
  paidAt     DateTime @default(now())
  recordedBy String?  // superAdmin username

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model Branch {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  address        String?
  phone          String?
  activationCode String   @unique @default(cuid())
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  users              User[]
  transactions       Transaction[]
  expenses           Expense[]
  cashierShifts      CashierShift[]
  stockBatches       ProductBatch[]
  syncLogs           SyncLog[]
  customers          Customer[]
  stockTransfersFrom StockTransfer[] @relation("TransferFrom")
  stockTransfersTo   StockTransfer[] @relation("TransferTo")
  storeSettings      StoreSettings[]
  auditLogs          AuditLog[]
  supplierLedgers    SupplierLedger[]
  offers             Offer[]

  @@unique([tenantId, name])
}

// ─── Role Enum ────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN     // مشغّل المنصة — يرى كل شيء
  ADMIN           // مدير المنظمة — يرى كل فروع منظمته
  BRANCH_MANAGER  // مدير الفرع — مقيّد بفرعه
  CASHIER         // كاشير — نقطة البيع فقط
  STOCK_KEEPER    // أمين مخزن — المخزون والموردين فقط
}

// ─── User & Auth ──────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  tenantId       String
  branchId       String? // null = access to all branches (ADMIN)
  username       String
  password       String // bcrypt hashed
  role           Role      @default(CASHIER)
  email          String?   @unique
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  transactions  Transaction[]
  shifts        CashierShift[]
  auditLogs     AuditLog[]
  notifications Notification[]
  refreshTokens RefreshToken[]

  @@unique([tenantId, username])
}

model SuperAdmin {
  id             String    @id @default(cuid())
  username       String    @unique
  password       String // bcrypt hashed
  email          String?   @unique
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id           String    @id @default(cuid())
  token        String    @unique
  userId       String?
  superAdminId String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  user       User?       @relation(fields: [userId], references: [id])
  superAdmin SuperAdmin? @relation(fields: [superAdminId], references: [id])
}

// ─── Catalog (Tenant-level, shared across branches) ──────────────────────────

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  offers   Offer[]

  @@unique([tenantId, name])
}

model Product {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  categoryId   String?
  supplierId   String?
  costPrice     Decimal  @default(0)
  baseStock     Int      @default(0) // legacy — prefer ProductBatch per branch
  minimumStock  Int      @default(0)
  isQuickSale   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  units            ProductUnit[]
  batches          ProductBatch[]
  transactionItems TransactionItem[]
  offers           Offer[]
}

model ProductUnit {
  id               String  @id @default(cuid())
  productId        String
  tenantId         String
  name             String
  conversionFactor Int     @default(1)
  barcode          String?
  price            Decimal @default(0)

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  transactionItems TransactionItem[]

  @@index([barcode, tenantId])
}

model ProductBatch {
  id          String    @id @default(cuid())
  tenantId    String // for tenant-scoped queries
  productId   String
  branchId    String // stock is per-branch
  batchNumber String?
  expiryDate  DateTime?
  quantity    Int
  costPrice   Decimal
  createdAt   DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id])
}

// ─── Suppliers ────────────────────────────────────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  phone       String?
  email       String?
  address     String?
  balance     Decimal  @default(0)
  creditLimit Decimal?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  products Product[]
  ledger   SupplierLedger[]
}

model SupplierLedger {
  id          String   @id @default(cuid())
  supplierId  String
  branchId    String?  // which branch made this transaction — null = legacy/global
  type        String   // PURCHASE | PAYMENT | RETURN
  amount      Decimal
  description String?
  date        DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])
}

// ─── Sales & Customers ────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String?
  name      String
  phone     String?
  email     String?
  address   String?
  balance   Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String
  type          String // SALE | RETURN | REFUND
  totalAmount   Decimal
  date          DateTime @default(now())
  userId        String?
  customerId    String?
  notes         String?
  discount      Decimal  @default(0)
  priceEdited   Boolean  @default(false) // true if any line price was changed from the catalog price at sale time
  taxAmount     Decimal  @default(0)
  paymentMethod String   @default("CASH") // CASH | CREDIT | SPLIT
  paidAmount    Decimal?
  originalTxId  String?
  offerId       String?
  receiptNumber String?  // tenant-scoped sequential number, stored permanently

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  branch   Branch            @relation(fields: [branchId], references: [id])
  user     User?             @relation(fields: [userId], references: [id])
  customer Customer?         @relation(fields: [customerId], references: [id])
  offer    Offer?            @relation(fields: [offerId], references: [id])
  items    TransactionItem[]
}

model TransactionItem {
  id            String  @id @default(cuid())
  transactionId String
  productId     String
  unitId        String
  quantity      Decimal @default(1)
  price         Decimal
  cost          Decimal @default(0)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  unit        ProductUnit @relation(fields: [unitId], references: [id])
}

// ─── Financial ────────────────────────────────────────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String
  title       String
  amount      Decimal
  category    String?
  description String?
  date        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
}

model CashierShift {
  id             String    @id @default(cuid())
  tenantId       String
  branchId       String
  userId         String
  openingAmount  Decimal   @default(0)
  closingAmount  Decimal?
  expectedAmount Decimal?
  difference     Decimal?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  notes          String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

// ─── Promotions ───────────────────────────────────────────────────────────────

model Offer {
  id          String    @id @default(cuid())
  tenantId    String
  branchId    String?
  name        String
  type        String // FIXED_DISCOUNT | PERCENTAGE_DISCOUNT | BUY_X_GET_Y
  value       Decimal
  buyQuantity Int?
  getQuantity Int?
  productId   String?
  categoryId  String?
  startDate   DateTime  @default(now())
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  transactions Transaction[]
}

// ─── Settings ─────────────────────────────────────────────────────────────────

model StoreSettings {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String   @unique
  storeName     String   @default("سوبر ماركت")
  storeAddress  String?
  storePhone    String?
  taxNumber     String?
  taxRate       Decimal  @default(0)
  currency      String   @default("ريال")
  footerMessage String?
  autoPrint     Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
}

// ─── Stock Transfers ──────────────────────────────────────────────────────────

model StockTransfer {
  id           String   @id @default(cuid())
  tenantId     String
  fromBranchId String
  toBranchId   String
  items        String // JSON: [{ productId, unitId, quantity }]
  status       String   @default("PENDING") // PENDING | APPROVED | COMPLETED | CANCELLED
  notes        String?
  requestedBy  String // userId
  approvedBy   String? // userId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  fromBranch Branch @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch @relation("TransferTo", fields: [toBranchId], references: [id])
}

// ─── Sync ─────────────────────────────────────────────────────────────────────

model SyncLog {
  id            String    @id @default(cuid())
  tenantId      String
  branchId      String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  status        String    @default("IN_PROGRESS") // IN_PROGRESS | SUCCESS | FAILED | PARTIAL
  recordsPushed Int       @default(0)
  recordsPulled Int       @default(0)
  conflicts     String? // JSON array
  error         String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
}

// ─── Audit & Notifications ───────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  branchId  String?
  userId    String?
  username  String?
  action    String
  entity    String
  entityId  String?
  details   String? // JSON
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String? // null = broadcast to all tenant users
  type      String // SUBSCRIPTION_EXPIRY | SYNC_FAILURE | LOW_STOCK | SYSTEM | STOCK_TRANSFER
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  type      String    @default("INFO") // INFO | WARNING | MAINTENANCE
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  recipients AnnouncementRecipient[]
}

model AnnouncementRecipient {
  id             String  @id @default(cuid())
  announcementId String
  tenantId       String
  isRead         Boolean @default(false)

  announcement Announcement @relation(fields: [announcementId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([announcementId, tenantId])
}

// ─── AI Usage Tracking ───────────────────────────────────────────────────────

model AiUsageLog {
  id       String @id @default(cuid())
  tenantId String
  date     String // YYYY-MM-DD
  count    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date])
}

// ─── Sync Delete Log ──────────────────────────────────────────────────────────
// Records every hard-delete that happens on cloud so desktop can mirror it.
// Pull route returns entries newer than pullCursor; desktop applyPull deletes
// the matching local rows. Entries older than HISTORY_DAYS are pruned by cleanup.

model CloudDeleteLog {
  id        String   @id @default(cuid())
  tenantId  String
  table     String   // 'products' | 'categories' | 'customers' | 'suppliers' | 'offers' | 'expenses'
  recordId  String   // primary key of the deleted row
  deletedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, deletedAt])
}

// ─── Desktop App Licenses ─────────────────────────────────────────────────────

// ─── Platform Payment Methods (managed by super-admin) ───────────────────────

model PlatformPaymentMethod {
  id            String   @id @default(cuid())
  type          String   // ZAINCASH | SUPERKEY | MASTERCARD | OTHER
  name          String   // "زين كاش", "سوبر كي", "ماستر كارد"
  accountNumber String?  // رقم الحساب / رقم الهاتف
  accountName   String?  // اسم صاحب الحساب
  instructions  String?  // تعليمات إضافية
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LicenseLog {
  id             String    @id @default(cuid())
  clientName     String
  clientPhone    String?
  clientAddress  String?
  duration       String    // 1M | 3M | 6M | 1Y | LIFETIME | custom Xd
  expiresAt      DateTime?
  generatedAt    DateTime  @default(now())
  licenseKey     String    @db.Text
  machineId      String?
  generatedBy    String?   // superAdminId
}
