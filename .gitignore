# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist
/dist2
/marketing_video
# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep .env.production (template only, no real secrets) but ignore actual .env
.env
.env.bak
.env.*.bak
*.bak
.env.local
.env.development.local
.env.test.local
.env.production.local
# Allow the production template (no real values)
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Cloud dev build
.next-cloud/

# Electron/desktop build output (Next standalone + bundled node_modules)
.next-build/

# Local SQLite databases — never commit real data
prisma/dev.db
prisma/dev.db-shm
prisma/dev.db-wal
prisma/prisma/

# Backups
backups/

# Electron/desktop local files
activation_params.json
offline-queue.js

# Temp / utility scripts
tmp_files.txt
check-db.js

# Claude Code local settings
.claude/settings.local.json
