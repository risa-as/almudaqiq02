{
  "description": "Supermarket Management System",
  "author": "Eyad Qaed",
  "name": "supermarket-core",
  "version": "0.1.0",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:cloud": "cross-env NEXT_DIST_DIR=.next-cloud next dev --port 3001",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "prisma:local": "prisma generate --schema=prisma/schema.local.prisma",
    "db:setup": "node scripts/setup-local-db.js",
    "db:push": "cross-env LOCAL_DATABASE_URL=file:./prisma/dev.db prisma db push --schema=prisma/schema.local.prisma --skip-generate",
    "electron": "cross-env IS_ELECTRON=1 LOCAL_DATABASE_URL=file:./prisma/dev.db SERVER_URL=http://localhost:3000/pos electron .",
    "dev:electron": "npx kill-port 3000 --silent & cross-env IS_ELECTRON=1 LOCAL_DATABASE_URL=file:./prisma/dev.db concurrently -k -n \"Next,Electron\" -c \"cyan,yellow\" \"next dev\" \"wait-on http://localhost:3000 && npm run electron\"",
    "electron:prod": "cross-env SERVER_URL=http://192.168.1.200:3000/pos electron .",
    "dist": "npm run prisma:local && npm run db:push && npm run build && npm run postbuild && electron-builder",
    "postbuild": "node scripts/prepare-standalone.js"
  },
  "build": {
    "appId": "com.supermarket.erp",
    "productName": "SupermarketPOS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!.next/dev/**",
      "!.next/cache/**",
      "!.next-cloud/**"
    ],
    "win": {
      "target": "nsis",
      "verifyUpdateCodeSignature": false,
      "legalTrademarks": "Eyad Qaed",
      "icon": "public/logo.ico"
    },
    "copyright": "Copyright (c) 2026 Eyad Qaed",
    "compression": "normal",
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "openai": "^6.38.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.7.0",
    "resend": "^4.0.0",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "prisma": "^5.22.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  }
}
